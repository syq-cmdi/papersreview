---
import type { CollectionEntry } from "astro:content";

interface Props {
  publication: CollectionEntry<"publication">;
  compact?: boolean;
  lang?: "zh" | "en";
}

const { publication, compact = false, lang = "zh" } = Astro.props;
const data = publication.data;

const statusMap = {
  published: "已发表",
  accepted: "已录用",
  rr: "R&R",
  submitted: "已投稿",
  working: "进行中"
};

const typeMap = {
  journal: "期刊",
  conference: "会议",
  book: "专著",
  chapter: "章节",
  preprint: "预印本",
  report: "报告"
};

const statusMapEn = {
  published: "Published",
  accepted: "Accepted",
  rr: "R&R",
  submitted: "Submitted",
  working: "Working"
};

const typeMapEn = {
  journal: "Journal",
  conference: "Conference",
  book: "Book",
  chapter: "Chapter",
  preprint: "Preprint",
  report: "Report"
};

const detailHref = `/${lang}/publications/${publication.id}/`;
const title = lang === "en" ? data.titleEn ?? data.title : data.title;
const abstract = lang === "en" ? data.abstractEn ?? data.abstract : data.abstract;
const venue = lang === "en" ? data.venueEn ?? data.venue : data.venue;
const statusLabel = lang === "en" ? statusMapEn[data.status] : statusMap[data.status];
const typeLabel = lang === "en" ? typeMapEn[data.type] : typeMap[data.type];
const authorText = lang === "en" ? data.authors.join(", ") : data.authors.join("、");
---

<article
  class="group rounded-card border border-border bg-background p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/70 hover:shadow-academic"
  data-publication-card
  data-year={data.year}
  data-status={data.status}
  data-type={data.type}
  data-tags={data.tags.join(" ")}
>
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
    <span class="rounded-full bg-academic/10 px-2.5 py-1 text-academic dark:bg-primary/15 dark:text-primary">{data.year}</span>
    <span class="rounded-full bg-signal/10 px-2.5 py-1 text-signal">{statusLabel}</span>
    <span class="rounded-full bg-muted px-2.5 py-1 text-muted-foreground">{typeLabel}</span>
  </div>
  <h3 class:list={["mt-4 font-serif font-semibold leading-snug text-foreground group-hover:text-accent", compact ? "text-xl" : "text-2xl"]}>
    <a href={detailHref}>{title}</a>
  </h3>
  <p class="mt-3 text-sm leading-6 text-muted-foreground">{authorText}{venue ? ` · ${venue}` : ""}</p>
  {abstract && <p class="mt-4 line-clamp-3 text-sm leading-6 text-muted-foreground">{abstract}</p>}
  <div class="mt-5 flex flex-wrap gap-2">
    {data.tags.map((tag) => <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">{tag}</span>)}
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <a class="text-sm font-semibold text-academic hover:text-accent dark:text-primary" href={detailHref}>{lang === "zh" ? "查看详情" : "Details"}</a>
    {
      data.bibtex && (
        <button
          class="rounded-card border border-border px-3 py-1.5 text-sm font-medium text-foreground transition hover:border-accent hover:text-accent"
          type="button"
          data-bibtex={encodeURIComponent(data.bibtex)}
        >
          {lang === "zh" ? "复制 BibTeX" : "Copy BibTeX"}
        </button>
      )
    }
    {data.doi && <a class="text-sm font-medium text-muted-foreground hover:text-accent" href={`https://doi.org/${data.doi}`}>DOI</a>}
    {data.pdf && <a class="text-sm font-medium text-muted-foreground hover:text-accent" href={data.pdf}>PDF</a>}
  </div>
</article>
