---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { byDateDesc } from "@/lib/content";

const publications = (await getCollection("publication")).sort(byDateDesc);
const years = [...new Set(publications.map((item) => item.data.year))].sort((a, b) => b - a);
const typeOptions = [
  ["all", "All types"],
  ["journal", "Journal"],
  ["conference", "Conference"],
  ["book", "Book"],
  ["chapter", "Chapter"],
  ["preprint", "Preprint"],
  ["report", "Report"]
];
---

<BaseLayout lang="en" title="Publications" description="Structured publication list with filters, DOI links and BibTeX copying.">
  <section class="border-b border-border bg-muted/40 py-14">
    <div class="container">
      <SectionHeading
        eyebrow="Publications"
        title="Publications"
        description="A structured bibliography for AI4S, computing economy, network resilience and Finance+AI research outputs."
      />
    </div>
  </section>

  <section class="py-10">
    <div class="container">
      <div class="rounded-card border border-border bg-background p-4 shadow-sm">
        <div class="grid gap-3 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">Search</span>
            <input id="publication-search" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent" type="search" placeholder="Search titles, abstracts, authors or tags" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">Year</span>
            <select id="publication-year" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent">
              <option value="all">All years</option>
              {years.map((year) => <option value={year}>{year}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">Type</span>
            <select id="publication-type" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent">
              {typeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
        </div>
      </div>

      <p id="publication-count" class="mt-6 text-sm text-muted-foreground">{publications.length} publications</p>
      <div id="publication-list" class="mt-5 grid gap-5 lg:grid-cols-2">
        {publications.map((publication) => <PublicationCard publication={publication} lang="en" />)}
      </div>
      <p id="publication-empty" class="mt-8 hidden rounded-card border border-border bg-muted/50 p-6 text-sm text-muted-foreground">No matching publications.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const list = document.querySelector("#publication-list");
  const search = document.querySelector("#publication-search");
  const year = document.querySelector("#publication-year");
  const type = document.querySelector("#publication-type");
  const count = document.querySelector("#publication-count");
  const empty = document.querySelector("#publication-empty");

  const applyFilters = () => {
    if (!(list instanceof HTMLElement)) return;
    const cards = [...list.querySelectorAll("[data-publication-card]")];
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
    const selectedYear = year instanceof HTMLSelectElement ? year.value : "all";
    const selectedType = type instanceof HTMLSelectElement ? type.value : "all";
    let visible = 0;

    for (const card of cards) {
      const element = card instanceof HTMLElement ? card : undefined;
      if (!element) continue;
      const matches =
        (!query || element.innerText.toLowerCase().includes(query)) &&
        (selectedYear === "all" || element.dataset.year === selectedYear) &&
        (selectedType === "all" || element.dataset.type === selectedType);
      element.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    }

    if (count) count.textContent = `${visible} publications`;
    empty?.classList.toggle("hidden", visible !== 0);
  };

  for (const input of [search, year, type]) {
    input?.addEventListener("input", applyFilters);
    input?.addEventListener("change", applyFilters);
  }

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("[data-bibtex]");
    if (!(button instanceof HTMLElement)) return;
    const encoded = button.dataset.bibtex;
    if (!encoded) return;
    await navigator.clipboard.writeText(decodeURIComponent(encoded));
    const previous = button.textContent;
    button.textContent = "Copied";
    window.setTimeout(() => {
      button.textContent = previous;
    }, 1400);
  });
</script>
