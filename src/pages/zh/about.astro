---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { site } from "@/lib/site";

const tracks = [
  {
    title: "大模型 API 与提示工程",
    description: "围绕 OpenAI、DeepSeek 等商用与国产大模型接口，训练学生完成金融任务拆解、提示模板设计、结果评估与合规使用。"
  },
  {
    title: "Finance-RAG 与知识图谱",
    description: "以年报、ESG 公告、舆情摘要和监管文本为语料，构建可追踪证据链，降低财务分析中的幻觉风险。"
  },
  {
    title: "本地 Agent 与自动化工作流",
    description: "将抓取、清洗、检索、推理、可视化和报告写作组织为可复用流程，支撑真实企业案例实训。"
  }
];

const phases = [
  {
    title: "基础知识",
    detail: "金融风险管理、财务指标、数字化转型与 AI for Science 基本概念。"
  },
  {
    title: "AI 工具实操",
    detail: "提示工程、Notebook、API 调用、向量检索与可解释输出。"
  },
  {
    title: "真实案例演练",
    detail: "上市公司财报、ESG 文本、监管材料与企业经营数据分析。"
  },
  {
    title: "成果沉淀",
    detail: "形成项目报告、代码仓库、案例材料和可复用教学资源。"
  }
];

const outcomes = [
  "理解金融风险、企业财报与数字化转型的核心概念",
  "掌握领域大模型、RAG、知识图谱与 Agent 的基础工程方法",
  "能够基于真实企业数据完成证据链可追踪的分析报告",
  "形成可进入论文、案例、竞赛和课程平台的阶段性成果"
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "基于领域大模型的财报智能分析应用",
  description: site.description,
  provider: {
    "@type": "CollegeOrUniversity",
    name: "北京邮电大学经济管理学院"
  },
  instructor: {
    "@type": "Person",
    name: "李飞",
    affiliation: site.organization
  }
};
---

<BaseLayout title="课程概览" description="金融+AI 跨学科实训课程目标、三轨技术架构、四阶段教学路径与产学研融合机制。" jsonLd={jsonLd}>
  <section class="border-b border-border bg-muted/40 py-16">
    <div class="container grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <SectionHeading
        eyebrow="About"
        title="课程概览"
        description="课程以“基于领域大模型的财报智能分析应用”为核心任务，将金融风险管理、财报分析、领域大模型与 AI for Science 研究范式连接为连续实训。"
      />
      <div class="rounded-card border border-border bg-background p-6 shadow-sm">
        <p class="text-sm font-semibold text-signal">培养目标</p>
        <p class="mt-3 text-base leading-8 text-muted-foreground">
          培养学生以金融问题为牵引，使用大模型、RAG、知识图谱和自动化 Agent 完成可信财务分析、风险研判与研究报告生成的能力。
        </p>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <SectionHeading
        eyebrow="Architecture"
        title="三轨技术架构"
        description="课程把工具调用、可信检索和工程自动化拆成三条可迭代路线，便于不同基础的学生分层推进。"
      />
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {tracks.map((track, index) => (
          <article class="rounded-card border border-border bg-background p-6 shadow-sm">
            <p class="text-sm font-semibold text-signal">Track {index + 1}</p>
            <h2 class="mt-3 font-serif text-2xl font-semibold text-foreground">{track.title}</h2>
            <p class="mt-4 text-sm leading-7 text-muted-foreground">{track.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-background py-16">
    <div class="container grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading
        eyebrow="Pedagogy"
        title="四阶段教学路径"
        description="课程采用“知识传授-AI 工具实操-真实案例演练”的递进模式，最终沉淀为可持续更新的案例库和成果库。"
      />
      <div class="relative">
        <div class="absolute left-4 top-4 h-[calc(100%-2rem)] w-px bg-border" aria-hidden="true"></div>
        <div class="space-y-5">
          {phases.map((phase, index) => (
            <article class="relative pl-12">
              <span class="absolute left-0 top-1 grid h-8 w-8 place-items-center rounded-full bg-academic text-sm font-semibold text-white">{index + 1}</span>
              <div class="rounded-card border border-border bg-muted/35 p-5">
                <h2 class="font-serif text-xl font-semibold text-foreground">{phase.title}</h2>
                <p class="mt-2 text-sm leading-7 text-muted-foreground">{phase.detail}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container grid gap-10 lg:grid-cols-2">
      <div>
        <SectionHeading
          eyebrow="Outcomes"
          title="学习产出"
          description="阶段性成果不仅服务课程考核，也进入学术论文、课程案例、开放资源与平台化演示。"
        />
        <ul class="mt-6 space-y-3">
          {outcomes.map((item) => (
            <li class="rounded-card border border-border bg-background p-4 text-sm leading-7 text-muted-foreground">{item}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-card border border-border bg-muted/35 p-6">
        <p class="text-sm font-semibold text-signal">产学研融合</p>
        <h2 class="mt-3 font-serif text-2xl font-semibold text-foreground">从课程任务到科研问题</h2>
        <p class="mt-4 text-sm leading-7 text-muted-foreground">
          课程材料与 AI4S 项目中期报告共同指向绿色算力网络、财报智能分析、AI+金融安全和知识网络韧性等方向。网站以内容文件驱动，后续可持续加入新论文、新案例、学生作品和企业合作成果。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
