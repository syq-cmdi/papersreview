---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { publicationJsonLd } from "@/lib/content";
import { site } from "@/lib/site";

export async function getStaticPaths() {
  const publications = await getCollection("publication");
  return publications.map((publication) => ({
    params: { id: publication.id },
    props: { publication }
  }));
}

const { publication } = Astro.props;
const { Content } = await render(publication);

const statusMap = {
  published: "已发表",
  accepted: "已录用",
  rr: "R&R",
  submitted: "已投稿",
  working: "进行中"
};
---

<BaseLayout
  title={publication.data.title}
  description={publication.data.abstract ?? "学术成果详情"}
  jsonLd={publicationJsonLd(publication, site.url)}
>
  <article class="container max-w-4xl py-14">
    <a href="/zh/publications/" class="text-sm font-semibold text-academic hover:text-accent dark:text-primary">返回成果列表</a>
    <div class="mt-6 flex flex-wrap gap-2 text-xs font-semibold">
      <span class="rounded-full bg-academic/10 px-2.5 py-1 text-academic dark:bg-primary/15 dark:text-primary">{publication.data.year}</span>
      <span class="rounded-full bg-signal/10 px-2.5 py-1 text-signal">{statusMap[publication.data.status]}</span>
      {publication.data.tags.map((tag) => <span class="rounded-full border border-border px-2.5 py-1 text-muted-foreground">{tag}</span>)}
    </div>
    <h1 class="mt-5 font-serif text-4xl font-semibold leading-tight text-foreground">{publication.data.title}</h1>
    <p class="mt-5 text-base leading-7 text-muted-foreground">{publication.data.authors.join("、")}{publication.data.venue ? ` · ${publication.data.venue}` : ""}</p>
    {publication.data.abstract && <p class="mt-8 rounded-card border border-border bg-muted/50 p-5 text-base leading-8 text-foreground">{publication.data.abstract}</p>}
    <div class="prose prose-slate mt-10 max-w-none dark:prose-invert">
      <Content />
    </div>
    {publication.data.bibtex && (
      <section class="mt-10">
        <h2 class="text-lg font-semibold text-foreground">BibTeX</h2>
        <pre class="mt-3 overflow-x-auto rounded-card border border-border bg-muted p-4 text-sm"><code>{publication.data.bibtex}</code></pre>
      </section>
    )}
  </article>
</BaseLayout>
