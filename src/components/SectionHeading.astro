---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-signal">{eyebrow}</p>}
  <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-foreground md:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-muted-foreground md:text-lg">{description}</p>}
</div>
