---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { byDateDesc } from "@/lib/content";

const publications = (await getCollection("publication")).sort(byDateDesc);
const years = [...new Set(publications.map((item) => item.data.year))].sort((a, b) => b - a);
const tags = [...new Set(publications.flatMap((item) => item.data.tags))].sort();

const statusOptions = [
  ["all", "全部状态"],
  ["published", "已发表"],
  ["accepted", "已录用"],
  ["rr", "R&R"],
  ["submitted", "已投稿"],
  ["working", "进行中"]
];

const typeOptions = [
  ["all", "全部类型"],
  ["journal", "期刊"],
  ["conference", "会议"],
  ["book", "专著"],
  ["chapter", "章节"],
  ["preprint", "预印本"],
  ["report", "报告"]
];
---

<BaseLayout title="学术成果" description="论文、会议、专著和研究报告的结构化展示，可按年份、类型、状态和标签筛选。">
  <section class="border-b border-border bg-muted/40 py-14">
    <div class="container">
      <SectionHeading
        eyebrow="Publications"
        title="学术成果"
        description="围绕网络韧性、算力经济、绿色算力网络、AI for Science 工程优化和金融科技方向，自动读取 content/publications 中的成果条目。"
      />
    </div>
  </section>

  <section class="py-10">
    <div class="container">
      <div class="rounded-card border border-border bg-background p-4 shadow-sm">
        <div class="grid gap-3 md:grid-cols-[1.2fr_0.8fr_0.8fr_0.8fr]">
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">全文搜索</span>
            <input id="publication-search" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent" type="search" placeholder="搜索题目、摘要、作者或标签" />
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">年份</span>
            <select id="publication-year" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent">
              <option value="all">全部年份</option>
              {years.map((year) => <option value={year}>{year}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">类型</span>
            <select id="publication-type" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent">
              {typeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-semibold text-muted-foreground">状态</span>
            <select id="publication-status" class="mt-1 w-full rounded-card border border-border bg-background px-3 py-2 text-sm outline-none transition focus:border-accent">
              {statusOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
        </div>
        <div class="mt-4 flex flex-wrap gap-2" aria-label="标签筛选">
          <button class="rounded-full bg-academic px-3 py-1.5 text-xs font-semibold text-white" type="button" data-tag-filter="all">全部标签</button>
          {tags.map((tag) => <button class="rounded-full border border-border px-3 py-1.5 text-xs font-semibold text-muted-foreground transition hover:border-accent hover:text-accent" type="button" data-tag-filter={tag}>{tag}</button>)}
        </div>
      </div>

      <p id="publication-count" class="mt-6 text-sm text-muted-foreground">{publications.length} 条成果</p>
      <div id="publication-list" class="mt-5 grid gap-5 lg:grid-cols-2">
        {publications.map((publication) => <PublicationCard publication={publication} />)}
      </div>
      <p id="publication-empty" class="mt-8 hidden rounded-card border border-border bg-muted/50 p-6 text-sm text-muted-foreground">没有匹配的成果。请调整筛选条件。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const list = document.querySelector("#publication-list");
  const search = document.querySelector("#publication-search");
  const year = document.querySelector("#publication-year");
  const type = document.querySelector("#publication-type");
  const status = document.querySelector("#publication-status");
  const count = document.querySelector("#publication-count");
  const empty = document.querySelector("#publication-empty");
  const tagButtons = [...document.querySelectorAll("[data-tag-filter]")];
  let activeTag = "all";

  const applyFilters = () => {
    if (!(list instanceof HTMLElement)) return;
    const cards = [...list.querySelectorAll("[data-publication-card]")];
    const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
    const selectedYear = year instanceof HTMLSelectElement ? year.value : "all";
    const selectedType = type instanceof HTMLSelectElement ? type.value : "all";
    const selectedStatus = status instanceof HTMLSelectElement ? status.value : "all";
    let visible = 0;

    for (const card of cards) {
      const element = card instanceof HTMLElement ? card : undefined;
      if (!element) continue;
      const haystack = element.innerText.toLowerCase();
      const matches =
        (!query || haystack.includes(query)) &&
        (selectedYear === "all" || element.dataset.year === selectedYear) &&
        (selectedType === "all" || element.dataset.type === selectedType) &&
        (selectedStatus === "all" || element.dataset.status === selectedStatus) &&
        (activeTag === "all" || (element.dataset.tags ?? "").includes(activeTag));
      element.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    }

    if (count) count.textContent = `${visible} 条成果`;
    empty?.classList.toggle("hidden", visible !== 0);
  };

  for (const input of [search, year, type, status]) {
    input?.addEventListener("input", applyFilters);
    input?.addEventListener("change", applyFilters);
  }

  for (const button of tagButtons) {
    button.addEventListener("click", () => {
      activeTag = button instanceof HTMLElement ? button.dataset.tagFilter ?? "all" : "all";
      for (const candidate of tagButtons) {
        candidate.classList.toggle("bg-academic", candidate === button);
        candidate.classList.toggle("text-white", candidate === button);
        candidate.classList.toggle("border", candidate !== button);
      }
      applyFilters();
    });
  }

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("[data-bibtex]");
    if (!(button instanceof HTMLElement)) return;
    const encoded = button.dataset.bibtex;
    if (!encoded) return;
    await navigator.clipboard.writeText(decodeURIComponent(encoded));
    const previous = button.textContent;
    button.textContent = "已复制";
    window.setTimeout(() => {
      button.textContent = previous;
    }, 1400);
  });
</script>
