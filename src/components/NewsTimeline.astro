---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"news">[];
  limit?: number;
}

const { items, limit } = Astro.props;
const visible = limit ? items.slice(0, limit) : items;

const categoryMap = {
  course: "课程",
  research: "科研",
  award: "获奖",
  talk: "报告",
  media: "媒体",
  milestone: "节点"
};

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
---

<div class="relative">
  <div class="absolute left-3 top-2 h-[calc(100%-1rem)] w-px bg-border" aria-hidden="true"></div>
  <div class="space-y-5">
    {
      visible.map((item) => (
        <article
          class="relative pl-10"
          data-news-item
          data-category={item.data.category}
          data-tags={item.data.tags.join(" ")}
          data-year={item.data.date.getFullYear()}
        >
          <span class="absolute left-0 top-1.5 h-6 w-6 rounded-full border-4 border-background bg-signal shadow-sm" aria-hidden="true"></span>
          <div class="rounded-card border border-border bg-background p-5 transition hover:border-accent/70 hover:shadow-academic">
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted-foreground">
              <time datetime={item.data.date.toISOString()}>{formatDate(item.data.date)}</time>
              <span class="rounded-full bg-muted px-2.5 py-1">{categoryMap[item.data.category]}</span>
            </div>
            <h3 class="mt-3 font-serif text-xl font-semibold text-foreground hover:text-accent">
              <a href={`/zh/news/${item.id}/`}>{item.data.title}</a>
            </h3>
            {item.data.summary && <p class="mt-3 text-sm leading-6 text-muted-foreground">{item.data.summary}</p>}
            <div class="mt-4 flex flex-wrap gap-2">
              {item.data.tags.map((tag) => <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">{tag}</span>)}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>
