---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { byDateDesc, byFeaturedThenDate } from "@/lib/content";
import { site } from "@/lib/site";

const publications = (await getCollection("publication")).sort(byFeaturedThenDate);
const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const news = (await getCollection("news")).sort(byDateDesc).slice(0, 3);

const stats = [
  { value: "6+", label: "Publications & Book" },
  { value: "4", label: "Core Students" },
  { value: "3", label: "Technology Tracks" },
  { value: "2025-2027", label: "AI4S Project Cycle" }
];
---

<BaseLayout lang="en" title={site.titleEn} description={site.descriptionEn}>
  <section class="border-b border-border bg-gradient-to-br from-background via-muted/50 to-background py-20">
    <div class="container grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
      <div>
        <p class="inline-flex rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-sm font-semibold text-signal">
          Finance + AI · AI for Science · BUPT
        </p>
        <h1 class="mt-6 font-serif text-5xl font-semibold leading-tight text-foreground">
          Finance+AI Course and AI4S Research Platform
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
          A bilingual hub for the interdisciplinary course, intelligent financial report analysis projects, AI4S research outputs and long-term updates.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/en/publications/" class="rounded-card bg-academic px-5 py-3 text-sm font-semibold text-white shadow-academic transition hover:bg-academic-2">Explore Publications</a>
          <a href="/en/team/" class="rounded-card border border-border bg-background/80 px-5 py-3 text-sm font-semibold text-foreground transition hover:border-accent hover:text-accent">Meet the Team</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {stats.map((stat) => (
          <div class="rounded-card border border-border bg-background p-5 shadow-sm">
            <p class="font-serif text-3xl font-semibold text-academic dark:text-primary">{stat.value}</p>
            <p class="mt-2 text-sm font-semibold text-muted-foreground">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          eyebrow="Highlights"
          title="Featured Research"
          description="Representative papers, book chapters and conference outputs extracted from the project materials."
        />
        <a href="/en/publications/" class="text-sm font-semibold text-academic hover:text-accent dark:text-primary">All publications</a>
      </div>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        {publications.slice(0, 3).map((publication) => <PublicationCard publication={publication} compact lang="en" />)}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-muted/40 py-16">
    <div class="container grid gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <SectionHeading
        eyebrow="Updates"
        title="Recent Milestones"
        description="Research, course and project milestones are maintained in Markdown files and published automatically."
      />
      <div class="grid gap-4">
        {news.map((item) => (
          <article class="rounded-card border border-border bg-background p-5 shadow-sm">
            <p class="text-xs font-semibold text-signal">{item.data.date.toISOString().slice(0, 10)}</p>
            <h2 class="mt-2 font-serif text-xl font-semibold text-foreground">{item.data.titleEn ?? item.data.title}</h2>
            {item.data.summaryEn && <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.data.summaryEn}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <SectionHeading eyebrow="Team" title="Faculty and Contributors" />
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {team.map((member) => (
          <article class="rounded-card border border-border bg-background p-5 shadow-sm">
            <img src={member.data.image ?? "/img/person3.jpg"} alt={`${member.data.nameEn ?? member.data.name} portrait`} class="h-16 w-16 rounded-card border border-border object-cover" loading="lazy" />
            <h2 class="mt-4 font-serif text-xl font-semibold text-foreground">{member.data.nameEn ?? member.data.name}</h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{member.data.roleEn ?? member.data.role}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
