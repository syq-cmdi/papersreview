---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { byDateDesc } from "@/lib/content";

const talks = (await getCollection("talks")).sort(byDateDesc);
const typeMap = {
  keynote: "主题报告",
  conference: "会议报告",
  invited: "受邀报告",
  monthly: "月度交流",
  seminar: "学术研讨"
};
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
---

<BaseLayout title="会议报告" description="AI4S 项目与 Finance+AI 课程相关会议报告、受邀演讲和学术交流。">
  <section class="border-b border-border bg-muted/40 py-14">
    <div class="container">
      <SectionHeading
        eyebrow="Talks"
        title="会议报告"
        description="统一展示项目月度交流、国际会议报告、行业论坛主题发言和可下载材料。"
      />
    </div>
  </section>

  <section class="py-12">
    <div class="container">
      <div class="relative">
        <div class="absolute left-3 top-2 h-[calc(100%-1rem)] w-px bg-border" aria-hidden="true"></div>
        <div class="space-y-6">
          {talks.map((talk) => (
            <article class="relative pl-10">
              <span class="absolute left-0 top-1.5 h-6 w-6 rounded-full border-4 border-background bg-academic shadow-sm" aria-hidden="true"></span>
              <div class="rounded-card border border-border bg-background p-6 shadow-sm transition hover:border-accent/70 hover:shadow-academic">
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted-foreground">
                  <time datetime={talk.data.date.toISOString()}>{formatDate(talk.data.date)}</time>
                  <span class="rounded-full bg-muted px-2.5 py-1">{typeMap[talk.data.type]}</span>
                  {talk.data.location && <span>{talk.data.location}</span>}
                </div>
                <h2 class="mt-3 font-serif text-2xl font-semibold leading-snug text-foreground hover:text-accent">
                  <a href={`/zh/talks/${talk.id}/`}>{talk.data.title}</a>
                </h2>
                <p class="mt-3 text-sm leading-6 text-muted-foreground">{talk.data.event} · {talk.data.speaker}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {talk.data.tags.map((tag) => <span class="rounded-full border border-border px-2.5 py-1 text-xs text-muted-foreground">{tag}</span>)}
                </div>
                <div class="mt-5 flex flex-wrap gap-3">
                  <a href={`/zh/talks/${talk.id}/`} class="text-sm font-semibold text-academic hover:text-accent dark:text-primary">查看详情</a>
                  {talk.data.slides && <a href={talk.data.slides} class="text-sm font-medium text-muted-foreground hover:text-accent">幻灯片</a>}
                  {talk.data.poster && <a href={talk.data.poster} class="text-sm font-medium text-muted-foreground hover:text-accent">海报</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
